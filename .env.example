APP_NAME=meister-jamjam-back
DEBUG=true

# DB: 운영은 mysql+aiomysql://user:pw@host:3306/jamjam, 로컬은 SQLite
DATABASE_URL=sqlite+aiosqlite:///./jamjam.db
AUTO_CREATE_TABLES=true      # 운영은 false로 두고 `alembic upgrade head` 사용
SEED_ON_STARTUP=true         # 운영은 false. 학교 기준표로 직접 입력

# 서비스 도메인 (변경 요청의 Origin 검사)
SERVICE_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false          # 로컬 http 개발용. 운영은 true

# 구글 로그인 (학교 계정 @bssm.hs.kr)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# 자진 신고 암호화 키: base64로 인코딩한 32바이트. 비우면 SECRET_KEY에서 파생(개발용)
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
SECRET_KEY=change-me

STORAGE_DIR=./storage

# 이메일 (자진 신고 접수 알림). SMTP_HOST를 비우면 발송하지 않고 로그만 남긴다
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
